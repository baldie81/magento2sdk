{
  "name": "baldie81/magento2-sdk",
  "description": "Framework-independent PHP SDK for the Magento 2 REST API: products, attributes, attribute sets, categories, orders, customers and the asynchronous bulk API.",
  "type": "library",
  "license": "MIT",
  "keywords": ["magento", "magento2", "rest", "api", "sdk", "ecommerce", "guzzle"],
  "authors": [
    {
      "name": "baldie81"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.5"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Baldie81\\Magento2SDK\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Baldie81\\Magento2SDK\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
